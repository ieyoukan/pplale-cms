# cp .env.example .env して各自の値を入れる（.env は commit しない）
# mise.toml の [env] で読み込まれる

# Discord の OAuth コールバックはローカル (http://localhost) を登録できない/
# 面倭なことが多いので、ログインをまるごと飛ばしたい場合は DEV_SKIP_AUTH=true にする。
# ALLOW_INSECURE_COOKIES=true のときだけ有効（本番では絶対に働かない）。
# 有効にすると DISCORD_CLIENT_ID/SECRET は不要になり、/auth/login が
# 即座に BOOTSTRAP_ADMIN_DISCORD_ID としてログインさせる。
# DEV_SKIP_AUTH=true

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# openssl rand -hex 32
SESSION_KEY=

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem
# openssl rand -hex 32（GitHub App の Webhook secret と同じ値）
GITHUB_WEBHOOK_SECRET=

# 自分の Discord ユーザーID。起動時に admin として許可リストに登録される
BOOTSTRAP_ADMIN_DISCORD_ID=

# 未設定ならインメモリ（再起動で消える）
# DATABASE_URL=postgres://pplale:pplale@localhost:5432/pplale_cms?sslmode=disable
