# cp .env.local.example .env.local して各自の値を入れる（.env.local は commit しない）
# mise.toml の [env] で読み込まれる

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# openssl rand -hex 32
SESSION_KEY=

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem
# openssl rand -hex 32（GitHub App の Webhook secret と同じ値）
GITHUB_WEBHOOK_SECRET=

# 自分の Discord ユーザーID。起動時に admin として許可リストに登録される
BOOTSTRAP_ADMIN_DISCORD_ID=

# 未設定ならインメモリ（再起動で消える）
# DATABASE_URL=postgres://pplale:pplale@localhost:5432/pplale_cms?sslmode=disable
